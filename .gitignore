# Default DENY: new root paths are never added accidentally.
/*
# Explicit exclusions, including the faucet, are intentional.
/faucet/
!/.gitignore
!/README.md
!/index.html
!/ads.txt
!/app-ads.txt
!/favicon.ico
!/robots.txt
!/sitemap.xml
!/css/
!/js/
!/images/
!/news/
!/privacy/
!/donate/

# Sensitive/operational files remain forbidden even within allowed public folders.
**/.*
!/.gitignore
**/*.php
**/*.cgi
**/*.pl
**/*.py
**/*.sh
**/*.env*
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.sql
**/*.db
**/*.sqlite*
**/*.log
**/*.bak
**/*.old
**/*.orig
**/*.zip
**/*.tar
**/*.tar.gz
**/*.tgz
**/*.7z
**/*.rar
**/*.map
**/*secret*
**/*credential*
**/*password*
**/*private*
**/*backup*

# Reviewed Google News source, generated initial sitemap, and schedule.
!/news-sitemap.xml
!/tools/
/tools/*
!/tools/digibyte-news-readiness.py
!/ops/
/ops/*
!/ops/digibyte-news-sitemap.cron

# Reviewed Markdown newsroom publishing workflow; faucet remains excluded.
!/tools/news-publisher.py
!/tools/NEWS_PUBLISHING.md

# Loopback-only reviewed private newsroom editor. Source is public; passwords and drafts are NEVER committed.
!/tools/newsroom-editor.py
!/tools/news-unpublish.py
!/tools/install-newsroom-editor.sh
!/tools/NEWSROOM_EDITOR.md
